---
interface Props { items: { question: string; answer: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((q) => (
    <details>
      <summary><span>{q.question}</span><i aria-hidden="true"></i></summary>
      <p>{q.answer}</p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; max-width: 820px; border-top: 1px solid var(--line-strong); }
  details { border-bottom: 1px solid var(--line-strong); }
  summary {
    cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 20px;
    padding: 22px 4px; font: 560 1.25rem/1.3 var(--display); color: var(--forest); border-radius: 6px;
  }
  summary:hover { color: var(--lake); }
  summary::-webkit-details-marker { display: none; }
  i { position: relative; flex: none; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line-strong); transition: background-color 0.2s, border-color 0.2s; }
  i::before, i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.75px; margin: -1px 0 0 -6px; background: var(--forest); border-radius: 2px; transition: transform 0.25s; }
  i::after { transform: rotate(90deg); }
  details[open] i { background: var(--forest); border-color: var(--forest); }
  details[open] i::before, details[open] i::after { background: #fff; }
  details[open] i::after { transform: rotate(0deg); }
  details p { padding: 0 60px 24px 4px; max-width: 70ch; color: #47524b; }
  @media (max-width: 560px) { details p { padding-right: 4px; } summary { font-size: 1.12rem; } }
</style>
