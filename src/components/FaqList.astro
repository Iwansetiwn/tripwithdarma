---
interface Props { items: { question: string; answer: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((q) => (
    <details>
      <summary><span>{q.question}</span></summary>
      <p>{q.answer}</p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 10px; max-width: 820px; }
  details { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; }
  summary {
    cursor: pointer; list-style: none; padding: 18px 52px 18px 20px; position: relative;
    font: 700 1.3rem/1.2 var(--display); text-transform: uppercase; color: var(--canopy);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: ''; position: absolute; right: 22px; top: 50%; width: 12px; height: 12px; margin-top: -8px;
    border-right: 3px solid var(--marker); border-bottom: 3px solid var(--marker); transform: rotate(45deg); transition: transform 0.2s;
  }
  details[open] summary::after { transform: rotate(-135deg); margin-top: -2px; }
  details p { padding: 0 20px 20px; max-width: 70ch; }
</style>
