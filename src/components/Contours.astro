---
// Decorative topographic lines (the Trail Map signature). Pure SVG, no image request.
interface Props { class?: string; opacity?: number }
const { class: cls, opacity = 0.22 } = Astro.props;
---
<svg class:list={['contours', cls]} viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" style={`opacity:${opacity}`}>
  <g fill="none" stroke="currentColor" stroke-width="1.4">
    <path d="M120 260c40-140 240-220 400-180s220 180 140 280-300 120-420 60-160-60-120-160z" />
    <path d="M170 262c32-104 196-164 324-132s172 136 108 208-240 88-336 44-124-44-96-120z" />
    <path d="M222 264c24-72 144-112 240-88s124 92 76 144-172 60-244 28-92-28-72-84z" />
    <path d="M276 266c16-40 92-64 156-48s80 52 48 84-108 36-156 16-60-16-48-52z" />
    <path d="M330 268c8-16 44-28 76-20s40 26 24 40-54 16-78 6-30-8-22-26z" />
    <path d="M-40 140c120-120 360-170 520-110s300 40 380-30" />
    <path d="M-40 100c140-130 380-160 540-100s290 20 360-50" />
    <path d="M-40 420c160 30 260 120 420 80s300-40 460 20" />
    <path d="M-40 460c180 20 270 90 430 60s290-20 450 30" />
  </g>
  <path d="M60 380 C180 330 260 400 360 330 S540 230 700 170" fill="none" stroke="#E4572E" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round" />
</svg>
<style>
  .contours { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>
