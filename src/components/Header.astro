---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';

const nav = [
  { href: '/tours/', label: 'Hikes' },
  { href: '/meet-your-guide/', label: 'Meet Ketut' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/blog/', label: 'Trip guides' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="container bar">
    <a href="/" class="home" aria-label="Trip with Darma, home"><Logo /></a>
    <nav aria-label="Main" class="desktop-nav">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <WhatsAppButton placement="header" label="Book a hike" class="header-cta" />
    <details class="mobile-nav">
      <summary aria-label="Menu"><Icon name="menu" size={24} /><span class="visually-hidden">Menu</span></summary>
      <nav aria-label="Mobile">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}<Icon name="arrow" size={18} /></a></li>
          ))}
        </ul>
        <WhatsAppButton placement="mobile-menu" label="Book on WhatsApp" class="menu-cta" />
      </nav>
    </details>
  </div>
</header>
<script is:inline>
  // Adds a hairline under the header once the page scrolls.
  (function () {
    var h = document.querySelector('[data-header]');
    if (!h) return;
    var on = function () { h.classList.toggle('scrolled', scrollY > 8); };
    addEventListener('scroll', on, { passive: true });
    on();
  })();
</script>
<style>
  .site-header {
    position: sticky; top: 0; z-index: 30;
    background: rgb(246 243 236 / 0.86);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .site-header.scrolled { border-bottom-color: var(--line); box-shadow: 0 6px 20px -16px rgb(23 38 31 / 0.4); }
  .bar { display: flex; align-items: center; gap: 12px; min-height: var(--header-h); }
  .home { text-decoration: none; margin-right: auto; border-radius: 12px; }
  .desktop-nav ul { display: flex; gap: 2px; list-style: none; }
  .desktop-nav a {
    position: relative; display: block; padding: 10px 13px; text-decoration: none; color: var(--ink);
    font: 550 0.98rem/1 var(--body); border-radius: 999px; transition: background-color 0.15s, color 0.15s;
  }
  .desktop-nav a:hover { background: rgb(31 61 48 / 0.06); color: var(--forest); }
  .desktop-nav a[aria-current='page'] { color: var(--forest); background: rgb(31 61 48 / 0.08); }
  .bar :global(.header-cta) { min-height: 44px; padding: 8px 18px; font-size: 0.95rem; margin-left: 8px; }
  .bar :global(.header-cta svg) { width: 18px; height: 18px; }

  .mobile-nav { display: none; }
  .mobile-nav summary {
    list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 999px; color: var(--forest); border: 1px solid var(--line-strong);
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav[open] summary { background: var(--forest); color: #fff; border-color: var(--forest); }
  .mobile-nav nav {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--bg); border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 40px -20px rgb(23 38 31 / 0.35);
    padding: 8px max(20px, env(safe-area-inset-right, 0px)) 20px max(20px, env(safe-area-inset-left, 0px));
    display: grid; gap: 16px;
  }
  .mobile-nav ul { list-style: none; display: grid; }
  .mobile-nav a:not(.btn) {
    display: flex; justify-content: space-between; align-items: center; padding: 16px 2px; text-decoration: none;
    color: var(--forest); font: 560 1.35rem/1.1 var(--serif); border-bottom: 1px solid var(--line);
  }
  .mobile-nav a:not(.btn) :global(svg) { color: var(--clay); }
  .mobile-nav a[aria-current='page'] { color: var(--clay-ink); }
  .mobile-nav :global(.menu-cta) { width: 100%; }
  @media (max-width: 1020px) {
    .desktop-nav { display: none; }
    .mobile-nav { display: block; }
  }
  @media (max-width: 560px) {
    .bar :global(.header-cta) { display: none; }
    .bar { --header-h: 64px; }
  }
</style>
