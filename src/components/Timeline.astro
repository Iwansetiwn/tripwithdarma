---
interface Props { steps: { time?: string; title: string; text?: string }[] }
const { steps } = Astro.props;
---
<ol class="timeline">
  {steps.map((s) => (
    <li>
      {s.time && <time>{s.time}</time>}
      <div>
        <h3>{s.title}</h3>
        {s.text && <p>{s.text}</p>}
      </div>
    </li>
  ))}
</ol>
<style>
  .timeline { list-style: none; display: grid; position: relative; }
  li { display: grid; grid-template-columns: 60px 1fr; gap: 18px; position: relative; padding-bottom: 26px; }
  li::before { content: ''; position: absolute; left: 77px; top: 14px; bottom: -6px; border-left: 2px dotted var(--line-strong); }
  li:last-child::before { display: none; }
  li > div { position: relative; padding-left: 24px; }
  li > div::before {
    content: ''; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%;
    background: var(--paper); border: 3px solid var(--clay);
  }
  time { font: 600 1rem/1.5 var(--body); color: var(--lake); font-variant-numeric: tabular-nums; padding-top: 1px; }
  h3 { font-size: 1.2rem; line-height: 1.3; }
  p { color: var(--muted); margin-top: 4px; }
</style>
