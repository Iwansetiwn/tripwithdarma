---
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src?: string;
  alt?: string;
  widths?: number[];
  sizes: string;
  aspect?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt = '', widths = [400, 640, 960, 1280], sizes, aspect = '4 / 3', eager = false, class: cls } = Astro.props;
const image = resolveImage(src);
// Renders nothing when no photo is set, so layouts collapse cleanly instead of showing a placeholder.
---
{image ? (
  <Picture
    src={image}
    alt={alt}
    widths={widths.filter((w) => w <= image.width)}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
    class:list={['photo', cls]}
    style={`aspect-ratio:${aspect}`}
  />
) : src ? (
  <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} class:list={['photo', cls]} style={`aspect-ratio:${aspect}`} />
) : null}
<style>
  :global(.photo) { width: 100%; height: auto; object-fit: cover; border-radius: var(--radius); background: var(--sand); }
</style>
