---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import FactRow from './FactRow.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
import { bookingMessage } from '../lib/site';
interface Props { tour: CollectionEntry<'tours'>; headingLevel?: 'h2' | 'h3' }
const { tour, headingLevel = 'h3' } = Astro.props;
const d = tour.data;
const H = headingLevel;
const url = `/tours/${tour.id}/`;
---
<article class="tour-card">
  <a href={url} class="img-link" tabindex="-1" aria-hidden="true">
    <Photo src={d.cover} alt={d.coverAlt ?? ''} sizes="(max-width: 760px) 100vw, 380px" aspect="3 / 2" widths={[400, 640, 800]} />
  </a>
  <div class="body">
    <H class="title"><a href={url}>{d.shortTitle ?? d.title}</a></H>
    <FactRow tour={d} />
    <p>{d.summary}</p>
    <div class="actions">
      <WhatsAppButton placement="tour-card" tour={d.title} message={bookingMessage(d.title)} label="Book" />
      <a href={url} class="more">Details <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</article>
<style>
  .tour-card { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .img-link :global(.photo) { border-radius: 0; }
  .body { padding: 20px; display: grid; gap: 14px; align-content: start; grid-template-rows: auto auto 1fr auto; }
  .title { font-size: 1.7rem; text-transform: uppercase; }
  .title a { color: var(--canopy); text-decoration: none; }
  .title a:hover { color: var(--lake); }
  .body p { color: var(--muted); }
  .actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; text-decoration: none; }
</style>
