---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { formatPrice } from '../lib/site';
interface Props { tour: CollectionEntry<'tours'>; headingLevel?: 'h2' | 'h3' }
const { tour, headingLevel = 'h3' } = Astro.props;
const d = tour.data;
const H = headingLevel;
const url = `/tours/${tour.id}/`;
const price = formatPrice(d.price, d.priceCurrency);
---
<article class="tour-card">
  {d.cover && (
    <div class="media">
      <Photo src={d.cover} alt={d.coverAlt ?? ''} sizes="(max-width: 760px) 100vw, 400px" aspect="4 / 3" widths={[400, 640, 800]} />
      <span class={`badge level level-${d.difficulty.toLowerCase()}`}><span class="visually-hidden">Difficulty: </span>{d.difficulty}</span>
    </div>
  )}
  <div class="body">
    <H class="title"><a href={url}>{d.shortTitle ?? d.title}</a></H>
    <ul class="meta" aria-label="Hike facts">
      <li><Icon name="clock" size={17} /><span class="visually-hidden">Duration: </span>{d.duration}</li>
      {!d.cover && <li class={`level level-${d.difficulty.toLowerCase()}`}><span class="visually-hidden">Difficulty: </span>{d.difficulty}</li>}
      {d.distanceKm && <li><Icon name="route" size={17} />{d.distanceKm} km</li>}
      {d.groupSize && <li><Icon name="users" size={17} />{d.groupSize.replace(/^Private,?\s*/i, '')}</li>}
    </ul>
    <p class="summary">{d.summary}</p>
    <div class="foot">
      <p class="price">
        {price ? <><span class="from">From</span><strong>{price}</strong><span class="unit">{d.priceUnit}</span></> : <><span class="from">Price</span><strong class="ask">On request</strong></>}
      </p>
      <span class="go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
    </div>
  </div>
</article>
<style>
  .tour-card {
    position: relative; display: grid; grid-template-rows: auto 1fr; overflow: hidden;
    background: var(--paper); border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--shadow);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .tour-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .tour-card:focus-within { box-shadow: var(--shadow-lift); }
  .media { position: relative; overflow: hidden; }
  .media :global(.photo) { border-radius: 0; transition: transform 0.6s ease; }
  .tour-card:hover .media :global(.photo) { transform: scale(1.03); }
  .badge {
    position: absolute; left: 14px; top: 14px; padding: 7px 12px 7px 11px; border-radius: 999px;
    background: rgb(255 253 248 / 0.94); font: 650 0.82rem/1 var(--body); color: var(--ink); box-shadow: 0 2px 8px rgb(0 0 0 / 0.08);
  }
  .body { padding: 22px 22px 20px; display: grid; gap: 12px; grid-template-rows: auto auto 1fr auto; }
  .title { font-size: 1.5rem; }
  .title a { color: var(--forest); text-decoration: none; }
  /* Whole card is the link target */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .title a:focus-visible { outline: none; }
  .title a:focus-visible::after { outline: 3px solid var(--clay); outline-offset: -3px; border-radius: 20px; }
  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.92rem; color: var(--muted); }
  .meta li { display: inline-flex; align-items: center; gap: 6px; }
  .meta :global(svg) { color: var(--lake); }
  .summary { color: #47524b; }
  .foot { display: flex; align-items: end; justify-content: space-between; gap: 12px; padding-top: 16px; margin-top: 4px; border-top: 1px solid var(--line); }
  .price { display: grid; gap: 2px; }
  .from { font: 650 0.72rem/1 var(--body); text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); }
  .price strong { font: 600 1.25rem/1.2 var(--display); color: var(--forest); }
  .price strong.ask { font-size: 1.05rem; }
  .unit { font-size: 0.85rem; color: var(--muted); }
  .go {
    width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center;
    background: var(--bg); color: var(--forest); border: 1px solid var(--line); transition: background-color 0.2s, color 0.2s;
  }
  .tour-card:hover .go { background: var(--forest); color: #fff; border-color: var(--forest); }
</style>
