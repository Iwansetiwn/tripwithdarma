---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getSite, getTours, waLink } from '../lib/site';

const site = await getSite();
const tours = await getTours();
const a = site.address;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div class="brand">
      <Logo inverted />
      <p>{site.tagline}.</p>
      <address>
        <strong>{site.businessName}</strong> ({site.guideName})<br />
        {a.street && <>{a.street}<br /></>}
        {a.village}, {a.district}, {a.regency}<br />
        {a.province} {a.postalCode}, Indonesia
      </address>
    </div>
    <div>
      <h2 class="fh">Hikes</h2>
      <ul>
        {tours.map((t) => <li><a href={`/tours/${t.id}/`}>{t.data.shortTitle ?? t.data.title}</a></li>)}
        <li><a href="/tours/">All hikes</a></li>
      </ul>
    </div>
    <div>
      <h2 class="fh">Plan</h2>
      <ul>
        <li><a href="/meet-your-guide/">Meet Ketut</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/blog/">Trip guides</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact &amp; map</a></li>
      </ul>
    </div>
    <div>
      <h2 class="fh">Contact</h2>
      <ul>
        <li>
          <a href={waLink(site.whatsapp, site.defaultWhatsappMessage)} target="_blank" rel="noopener" data-wa data-wa-placement="footer">
            <Icon name="whatsapp" size={18} /> WhatsApp{site.phoneDisplay && ` ${site.phoneDisplay}`}
          </a>
        </li>
        {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        {site.tripadvisorUrl && <li><a href={site.tripadvisorUrl} target="_blank" rel="noopener">Tripadvisor</a></li>}
        {site.googleBusinessUrl && <li><a href={site.googleBusinessUrl} target="_blank" rel="noopener">Google Maps</a></li>}
        {site.instagramUrl && <li><a href={site.instagramUrl} target="_blank" rel="noopener">Instagram</a></li>}
        {site.facebookUrl && <li><a href={site.facebookUrl} target="_blank" rel="noopener">Facebook</a></li>}
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>© {year} {site.businessName}. Private hiking in Munduk, North Bali.</p>
  </div>
</footer>
<style>
  .site-footer { position: relative; background: var(--forest-deep); color: #d3ddd5; padding-block: 64px 28px; border-top: 1px solid rgb(255 255 255 / 0.08); }
  .cols { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 40px; }
  .brand { display: grid; gap: 16px; align-content: start; }
  .brand > p { font: 500 1.05rem/1.5 var(--display); color: #e7eee9; max-width: 30ch; }
  address { font-style: normal; font-size: var(--step--1); line-height: 1.7; color: #a9bbaf; }
  address strong { color: #fff; font-weight: 600; }
  .fh { font: 650 0.75rem/1 var(--body); text-transform: uppercase; letter-spacing: 0.16em; color: var(--clay-light); margin-bottom: 18px; }
  ul { list-style: none; display: grid; gap: 10px; }
  a { color: #d3ddd5; text-decoration: none; display: inline-flex; gap: 8px; align-items: center; }
  a:hover { color: #fff; text-decoration: underline; }
  .legal { margin-top: 48px; font-size: var(--step--1); color: #8fa497; }
  .legal p { padding-top: 22px; border-top: 1px solid rgb(255 255 255 / 0.1); }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 420px) { .cols { grid-template-columns: 1fr; } }
</style>
