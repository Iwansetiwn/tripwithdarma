---
interface Props { items: { name: string; href?: string }[]; inverted?: boolean }
const { items, inverted = false } = Astro.props;
---
<nav aria-label="Breadcrumb" class:list={['crumbs', { inverted }]}>
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; font-size: var(--step--1); }
  li + li::before { content: '›'; margin: 0 6px 0 2px; opacity: 0.6; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--forest); text-decoration: underline; }
  .crumbs { color: var(--muted); }
</style>
