---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { formatDate } from '../lib/site';
interface Props { post: CollectionEntry<'blog'>; headingLevel?: 'h2' | 'h3' }
const { post, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const url = `/blog/${post.id}/`;
---
<article class="post-card">
  <a href={url} tabindex="-1" aria-hidden="true"><Photo src={post.data.cover} alt="" sizes="(max-width: 760px) 100vw, 380px" aspect="16 / 9" widths={[400, 640, 800]} label="Hiking guide" /></a>
  <div class="body">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <H><a href={url}>{post.data.title}</a></H>
    <p>{post.data.description}</p>
  </div>
</article>
<style>
  .post-card { display: grid; gap: 14px; align-content: start; }
  .body { display: grid; gap: 8px; }
  time { font-size: var(--step--1); color: var(--muted); }
  h2, h3 { font-size: 1.55rem; text-transform: uppercase; }
  h2 a, h3 a { color: var(--canopy); text-decoration: none; }
  h2 a:hover, h3 a:hover { color: var(--lake); }
  p { color: var(--muted); }
</style>
