---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { formatPrice } from '../lib/site';
interface Props { tour: CollectionEntry<'tours'>['data']; showPrice?: boolean; large?: boolean }
const { tour, showPrice = true, large = false } = Astro.props;
const price = formatPrice(tour.price, tour.priceCurrency);
---
<ul class:list={['facts', { large }]} aria-label="Hike facts">
  <li class="chip"><Icon name="clock" /><span class="visually-hidden">Duration:</span>{tour.duration}</li>
  {tour.distanceKm && <li class="chip"><Icon name="route" /><span class="visually-hidden">Distance:</span>{tour.distanceKm} km</li>}
  <li class="chip"><span class={`level level-${tour.difficulty.toLowerCase()}`}><span class="visually-hidden">Difficulty:</span>{tour.difficulty}</span></li>
  <li class="chip"><Icon name="users" />{tour.groupSize}</li>
  {showPrice && (
    <li class="chip price"><span class="visually-hidden">Price:</span>{price ? <>{price} <small>{tour.priceUnit}</small></> : 'Price on request'}</li>
  )}
</ul>
<style>
  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .price { background: var(--forest); color: #fff; border-color: transparent; }
  .price small { font-size: 0.8rem; opacity: 0.85; }
  .large .chip { font-size: 0.95rem; padding: 9px 14px; }
</style>
