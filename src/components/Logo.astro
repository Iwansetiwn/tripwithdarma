---
interface Props { inverted?: boolean }
const { inverted = false } = Astro.props;
---
<span class:list={['logo', { inverted }]}>
  <svg class="mark" width="40" height="40" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="12" fill="#1E3B2C" />
    <ellipse cx="20" cy="40" rx="10" ry="7" fill="#2C6E7F" />
    <ellipse cx="44" cy="24" rx="10" ry="7" fill="#2C6E7F" />
    <path d="M27 35 C34 32 30 28 37 27" fill="none" stroke="#E4572E" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 5" />
    <path d="M10 14h12" stroke="#E4572E" stroke-width="4" stroke-linecap="round" />
  </svg>
  <span class="words">
    <span class="name">Trip with Darma</span>
    <span class="sub">Munduk hiking guide</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--canopy); }
  .logo.inverted { color: var(--mist); }
  .inverted .mark rect { stroke: rgb(255 255 255 / 0.35); stroke-width: 2px; }
  .words { display: grid; line-height: 1; gap: 3px; }
  .name { white-space: nowrap; font: 700 1.45rem/1 var(--display); text-transform: uppercase; letter-spacing: 0.01em; }
  .sub { font: 600 0.72rem/1 var(--body); text-transform: uppercase; letter-spacing: 0.14em; color: var(--marker-ink); }
  .inverted .sub { color: var(--marker-light); }
</style>
