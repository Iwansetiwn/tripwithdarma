---
interface Props { inverted?: boolean }
const { inverted = false } = Astro.props;
---
<span class:list={['logo', { inverted }]}>
  <svg class="mark" width="38" height="38" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="#1F3D30" />
    <path d="M10 42 25 19l8.5 11.5 6-6L54 42Z" fill="#F6F3EC" stroke="#F6F3EC" stroke-width="3" stroke-linejoin="round" />
    <path d="M16 50.5h12M36 50.5h12" stroke="#8DB8BB" stroke-width="5" stroke-linecap="round" />
    <circle cx="25" cy="19" r="4.5" fill="#EFA58E" />
  </svg>
  <span class="words">
    <span class="name">Trip with Darma</span>
    <span class="sub">Munduk hiking guide</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 11px; color: var(--forest); }
  .logo.inverted { color: #fff; }
  .inverted .mark rect { fill: #2a4a3b; }
  .words { display: grid; line-height: 1; gap: 5px; }
  .name { white-space: nowrap; font: 800 1.15rem/1 var(--display); letter-spacing: -0.03em; }
  .sub { font: 600 0.68rem/1 var(--body); letter-spacing: 0.02em; color: var(--muted); }
  .inverted .sub { color: #a9bbaf; }
</style>
