---
interface Props { inverted?: boolean }
const { inverted = false } = Astro.props;
---
<span class:list={['logo', { inverted }]}>
  <svg class="mark" width="40" height="40" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="#1F3D30" />
    <path d="M6 44 21 26l8 9 9-14 20 23Z" fill="#4F6F52" />
    <ellipse cx="22" cy="47" rx="9" ry="4" fill="#8DB8BB" />
    <ellipse cx="42" cy="48" rx="10" ry="4.5" fill="#8DB8BB" />
    <circle cx="46" cy="17" r="5" fill="#EFA58E" />
  </svg>
  <span class="words">
    <span class="name">Trip with Darma</span>
    <span class="sub">Munduk hiking guide</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; color: var(--forest); }
  .logo.inverted { color: #fff; }
  .inverted .mark rect { fill: #2a4a3b; }
  .words { display: grid; line-height: 1; gap: 4px; }
  .name { white-space: nowrap; font: 600 1.35rem/1 var(--serif); letter-spacing: -0.01em; }
  .sub { font: 600 0.7rem/1 var(--body); text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); }
  .inverted .sub { color: #b9c8bd; }
</style>
