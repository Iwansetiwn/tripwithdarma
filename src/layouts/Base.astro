---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
import { getSite } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  schema?: object;
  noindex?: boolean;
  sticky?: { message?: string; tour?: string; priceLine?: string } | false;
  publishedTime?: Date;
}
const { title, description, image, imageAlt, type = 'website', schema, noindex = false, sticky = {}, publishedTime } = Astro.props;
const site = await getSite();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? '/og-default.jpg', Astro.site).href;
const ga = site.ga4Id;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* hreflang-ready: add an "id" alternate here when the Indonesian version exists. */}
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1E3B2C" />

    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? 'Trip with Darma, hiking in Munduk, North Bali'} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {ga && (
      <script is:inline define:vars={{ ga }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        var stored = null;
        try { stored = localStorage.getItem('consent'); } catch (e) {}
        gtag('consent', 'default', {
          analytics_storage: stored === 'granted' ? 'granted' : 'denied',
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        });
        gtag('js', new Date());
        gtag('config', ga);
        // Load GA after the page is interactive so it never competes with the content.
        addEventListener('load', function () {
          (window.requestIdleCallback || setTimeout)(function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga;
            document.head.appendChild(s);
          });
        });
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {sticky !== false && <StickyWhatsApp {...sticky} />}

    {ga && (
      <div class="consent" id="consent" hidden>
        <p>We use Google Analytics cookies to see which hikes people are interested in. Is that OK?</p>
        <div>
          <button type="button" class="btn btn-outline" data-consent="denied">No thanks</button>
          <button type="button" class="btn btn-wa" data-consent="granted">Accept</button>
        </div>
      </div>
    )}

    <script is:inline>
      // WhatsApp click tracking: one "whatsapp_click" event per tap, with the tour and button position.
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-wa]');
        if (!a) return;
        var detail = { tour: a.dataset.waTour || '(general)', placement: a.dataset.waPlacement || 'unknown', page: location.pathname };
        if (window.gtag) window.gtag('event', 'whatsapp_click', detail);
      });
      (function () {
        var box = document.getElementById('consent');
        if (!box) return;
        var stored = null;
        try { stored = localStorage.getItem('consent'); } catch (e) {}
        if (!stored) box.hidden = false;
        box.addEventListener('click', function (e) {
          var v = e.target.closest('[data-consent]');
          if (!v) return;
          var choice = v.getAttribute('data-consent');
          try { localStorage.setItem('consent', choice); } catch (e2) {}
          if (window.gtag) window.gtag('consent', 'update', { analytics_storage: choice });
          box.hidden = true;
        });
      })();
    </script>
  </body>
</html>
<style>
  .consent {
    position: fixed; z-index: 40; left: 16px; right: 16px; bottom: calc(var(--sticky-h) + 12px);
    max-width: 520px; margin-inline: auto; background: var(--paper); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: 0 10px 30px rgb(21 27 23 / 0.18); padding: 16px; display: grid; gap: 12px; font-size: var(--step--1);
  }
  .consent[hidden] { display: none; }
  .consent div { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
  .consent .btn { min-height: 40px; padding: 8px 16px; font-size: 0.95rem; }
</style>
