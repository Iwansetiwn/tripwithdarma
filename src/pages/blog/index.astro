---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Ridges from '../../components/Ridges.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/site';
import { breadcrumbSchema, graph } from '../../lib/schema';

const posts = await getPosts();
const url = new URL('/blog/', Astro.site).href;
const schema = graph(
  { '@type': 'Blog', url, name: 'Munduk hiking guides', publisher: { '@id': 'https://tripwithdarma.my.id/#business' } },
  breadcrumbSchema([{ name: 'Home', url: Astro.site!.href }, { name: 'Guides', url }]),
);
---
<Base
  title="Munduk Hiking Guides | Twin Lakes Tips, Seasons & Packing Lists"
  description="Practical guides for hiking in Munduk and the Twin Lakes of North Bali: best time to go, what to pack, getting there, and which trail to choose."
  schema={schema}
>
  <section class="page-hero">
    <Ridges />
    <div class="container inner">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Guides' }]}/>
      <h1>Munduk hiking guides</h1>
      <p>Local tips for planning your hike: seasons, trails, packing and getting to the highlands.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-cards">
      {posts.map((p) => <PostCard post={p} headingLevel="h2" />)}
    </div>
  </section>
</Base>
