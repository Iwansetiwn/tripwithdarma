---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Ridges from '../components/Ridges.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getGuide, getSite, hasReviews } from '../lib/site';
import { breadcrumbSchema, personSchema, businessSchema, graph } from '../lib/schema';
import { ogImageUrl } from '../lib/og';

const guide = await getGuide();
const site = await getSite();
const url = new URL('/meet-your-guide/', Astro.site).href;
const og = await ogImageUrl(guide.photo);
const paragraphs = guide.story.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const schema = graph(
  { '@type': 'ProfilePage', url, mainEntity: personSchema(guide, Astro.site!, og) },
  businessSchema(site, guide, Astro.site!),
  breadcrumbSchema([{ name: 'Home', url: Astro.site!.href }, { name: 'Meet your guide', url }]),
);
---
<Base
  title={`Meet ${guide.name} | Your Local Munduk Hiking Guide`}
  description={`${guide.name} is a local hiking guide in Munduk, North Bali. Read his story, the languages he speaks and why hikers choose him for the Twin Lakes.`}
  image={og}
  imageAlt={guide.photoAlt}
  schema={schema}
>
  <section class="page-hero">
    <Ridges />
    <div class="container inner">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Meet your guide' }]}/>
      <p class="eyebrow">Meet your guide</p>
      <h1>{guide.name}</h1>
      <p>{guide.role}</p>
    </div>
  </section>

  <section class="section">
    <div class:list={['container about', { 'no-photo': !guide.photo }]}>
      {guide.photo && <div class="portrait">
        <Photo src={guide.photo} alt={guide.photoAlt ?? guide.name} eager sizes="(max-width: 860px) 100vw, 440px" aspect="4 / 5" widths={[400, 640, 880]} />
      </div>}
      <div class="story">
        <p class="intro">{guide.shortIntro}</p>
        <div class="prose">{paragraphs.map((p) => <p>{p}</p>)}</div>

        <dl class="facts">
          {guide.homeVillage && <div><dt>Home village</dt><dd>{guide.homeVillage}</dd></div>}
          {guide.yearsGuiding && <div><dt>Guiding since</dt><dd>{guide.yearsGuiding}+ years</dd></div>}
          {guide.languages.length > 0 && <div><dt>Languages</dt><dd>{guide.languages.join(', ')}</dd></div>}
          {guide.certifications.length > 0 && <div><dt>Certifications</dt><dd>{guide.certifications.join(', ')}</dd></div>}
        </dl>

        {guide.promises.length > 0 && (
          <ul class="promises">
            {guide.promises.map((p) => <li><Icon name="check" size={20} />{p}</li>)}
          </ul>
        )}
        <div><WhatsAppButton placement="about" label="Ask Ketut on WhatsApp" /></div>
      </div>
    </div>
  </section>

  {(await hasReviews()) && (
    <section class="section band">
      <div class="container">
        <div class="section-head"><p class="eyebrow">Reviews</p><h2>What hikers say about Ketut</h2></div>
        <Reviews limit={6} />
      </div>
    </section>
  )}
</Base>
<style>
  .about { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 88px); align-items: start; }
  .about.no-photo { grid-template-columns: minmax(0, 1fr); max-width: 760px; }
  .portrait { position: sticky; top: calc(var(--header-h) + 24px); }
  .portrait :global(.photo) { border-radius: 24px; box-shadow: var(--shadow-lift); object-position: 50% 90%; }
  .story { display: grid; gap: 28px; }
  .intro { font: 450 var(--step-2)/1.4 var(--display); color: var(--forest); max-width: 38ch; }
  .prose { font-size: 1.1rem; color: #3f4a43; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: 12px; }
  .facts div { background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px; }
  dt { font: 650 0.72rem/1 var(--body); color: var(--muted); text-transform: uppercase; letter-spacing: 0.14em; }
  dd { margin: 8px 0 0; font: 560 1.25rem/1.2 var(--display); color: var(--forest); }
  .promises { list-style: none; display: grid; gap: 12px; padding: 22px 24px; background: var(--sand); border-radius: 18px; }
  .promises li { display: flex; gap: 12px; align-items: flex-start; font-weight: 550; }
  .promises :global(svg) { color: var(--clay); margin-top: 3px; flex: none; }
  .band { background: var(--paper); border-block: 1px solid var(--line); }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .portrait { position: static; max-width: 460px; } }
</style>
