---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Ridges from '../components/Ridges.astro';
import FaqList from '../components/FaqList.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getFaq } from '../lib/site';
import { breadcrumbSchema, faqSchema, graph } from '../lib/schema';

const items = await getFaq();
const categories = [...new Set(items.map((i) => i.category))];
const url = new URL('/faq/', Astro.site).href;
const schema = graph(faqSchema(items), breadcrumbSchema([{ name: 'Home', url: Astro.site!.href }, { name: 'FAQ', url }]));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, '-').replace(/^-|-$/g, '');
---
<Base
  title="Munduk Hiking FAQ | Booking, Weather & What to Wear"
  description="Answers before you hike in Munduk: how to book on WhatsApp, the best season, rain, fitness level, what to wear and bring, cancellations and pickup."
  schema={schema}
>
  <section class="page-hero">
    <Ridges />
    <div class="container inner">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'FAQ' }]}/>
      <h1>Questions &amp; answers</h1>
      <p>Everything hikers usually ask before a Twin Lakes or waterfall hike.</p>
    </div>
  </section>
  <div class="container section layout">
    <nav aria-label="FAQ topics" class="topics">
      <ul>{categories.map((c) => <li><a href={`#${slug(c)}`}>{c}</a></li>)}</ul>
    </nav>
    <div class="groups">
      {categories.map((c) => (
        <section id={slug(c)} aria-labelledby={`h-${slug(c)}`}>
          <h2 id={`h-${slug(c)}`}>{c}</h2>
          <FaqList items={items.filter((i) => i.category === c)} />
        </section>
      ))}
      <div class="ask">
        <h2>Still wondering?</h2>
        <p>Ask Ketut directly. He usually replies the same day.</p>
        <WhatsAppButton placement="faq" label="Ask on WhatsApp" />
      </div>
    </div>
  </div>
</Base>
<style>
  .layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; align-items: start; }
  .topics { position: sticky; top: calc(var(--header-h) + 24px); }
  .topics ul { list-style: none; display: grid; gap: 2px; border-left: 2px solid var(--line); }
  .topics a { display: block; padding: 9px 0 9px 16px; margin-left: -2px; border-left: 2px solid transparent; font-weight: 600; text-decoration: none; color: var(--muted); }
  .topics a:hover { color: var(--forest); border-left-color: var(--clay); }
  .groups { display: grid; gap: 56px; }
  .groups h2 { font-size: var(--step-2); margin-bottom: 8px; }
  .ask { display: grid; gap: 12px; justify-items: start; padding: clamp(24px, 4vw, 40px); background: var(--sand); border-radius: 22px; }
  .ask p { color: var(--muted); }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 24px; }
    .topics { position: static; }
    .topics ul { display: flex; flex-wrap: wrap; gap: 8px; border: 0; }
    .topics a { padding: 8px 14px; margin: 0; background: var(--paper); border: 1px solid var(--line); border-radius: 999px; color: var(--forest); }
  }
</style>
